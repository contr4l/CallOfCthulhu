  "paragraphs": [
    {
      "id": "577:p0",
      "text": "577"
    },
    {
      "id": "577:p1",
      "text": "你顺坡滑进女孩被绑的洼地。她看着你走来，咬紧牙关，眼里满是恐惧与戒备。"
    },
    {
      "id": "577:p2",
      "text": "你保持礼貌距离，问道：“他们为什么这样对你？你愿意让我们帮忙吗？”"
    },
    {
      "id": "577:p3",
      "text": "她阴沉地盯着你，用断断续续的本族语言和英语回答：“我的族人害怕森林里的异类。每年这个时候，都要把我们中的一个献给它们，这样它们就不会迷惑所有人。走吧。”"
    },
    {
      "id": "577:p4",
      "text": "她似乎已经认命。"
    },
    {
      "id": "577:p5",
      "text": "割开绳子，强迫她离开这个危险的地方，前往578。把她留在原地，前往513。"
    },
    {
      "id": "577:p6",
      "text": "（576、583）"
    }
  ],
  "notes": []
}
