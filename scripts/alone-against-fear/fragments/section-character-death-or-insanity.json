      "kind": "heading",
      "text": "Character Death or Insanity\n",
      "sourceLocation": "pdf:spans:[[6,96,124]]"
    },
    {
      "id": "section-character-death-or-insanity:p1",
      "kind": "body",
      "text": "If your character is killed (goes to 0\nLife) or becomes insane (goes to 0\nSanity), you lose the game and\nmust start over with a new\ncharacter. Do not feel bad if this\nhappens — it takes a combination\nof luck and sound decisions to win.\n",
      "sourceLocation": "pdf:spans:[[6,124,163],[6,163,198],[6,198,229],[6,229,256],[6,256,291],[6,291,324],[6,324,360]]"
    }
