{
  "id": "unique-event-016",
  "paragraphs": [
    {
      "id": "unique-event-016:p0000",
      "kind": "body",
      "text": "#16 - train to nowhere\n",
      "sourceLocation": "pdf:spans:[[83,1615,1638]]"
    },
    {
      "id": "unique-event-016:p0001",
      "kind": "body",
      "text": "You sit down as the train reaches\n",
      "sourceLocation": "pdf:spans:[[83,1638,1672]]"
    },
    {
      "id": "unique-event-016:p0002",
      "kind": "body",
      "text": "full speed. Soon the rhythmic\n",
      "sourceLocation": "pdf:spans:[[83,1672,1702]]"
    },
    {
      "id": "unique-event-016:p0003",
      "kind": "body",
      "text": "motion of the train lulls you to\n",
      "sourceLocation": "pdf:spans:[[83,1702,1735]]"
    },
    {
      "id": "unique-event-016:p0004",
      "kind": "body",
      "text": "sleep.\n",
      "sourceLocation": "pdf:spans:[[83,1735,1742]]"
    },
    {
      "id": "unique-event-016:p0005",
      "kind": "body",
      "text": "You wake up after a couple of\n",
      "sourceLocation": "pdf:spans:[[83,1742,1772]]"
    },
    {
      "id": "unique-event-016:p0006",
      "kind": "body",
      "text": "stops. You feel refreshed. Heal 2\n",
      "sourceLocation": "pdf:spans:[[83,1772,1806]]"
    },
    {
      "id": "unique-event-016:p0007",
      "kind": "body",
      "text": "Life.\n",
      "sourceLocation": "pdf:spans:[[83,1806,1812]]"
    },
    {
      "id": "unique-event-016:p0008",
      "kind": "body",
      "text": "You get off the train and continue\n",
      "sourceLocation": "pdf:spans:[[83,1812,1847]]"
    },
    {
      "id": "unique-event-016:p0009",
      "kind": "body",
      "text": "your exploration of the town, but\n",
      "sourceLocation": "pdf:spans:[[83,1847,1881]]"
    },
    {
      "id": "unique-event-016:p0010",
      "kind": "body",
      "text": "you now have traveled 1 or 2\n",
      "sourceLocation": "pdf:spans:[[83,1881,1910]]"
    },
    {
      "id": "unique-event-016:p0011",
      "kind": "body",
      "text": "boxes from your previous location\n",
      "sourceLocation": "pdf:spans:[[83,1910,1944]]"
    },
    {
      "id": "unique-event-016:p0012",
      "kind": "body",
      "text": "(you choose where).",
      "sourceLocation": "pdf:spans:[[83,1944,1963]]"
    }
  ],
