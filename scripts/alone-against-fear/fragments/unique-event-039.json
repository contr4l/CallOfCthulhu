    {
      "id": "unique-event-039:p0000",
      "kind": "body",
      "text": "#39 - The Kid tells a story\n",
      "sourceLocation": "pdf:spans:[[93,1742,1770]]"
    },
    {
      "id": "unique-event-039:p0001",
      "kind": "body",
      "text": "The kid explains that there are\n",
      "sourceLocation": "pdf:spans:[[93,1770,1802]]"
    },
    {
      "id": "unique-event-039:p0002",
      "kind": "body",
      "text": "two gangs of children and teens\n",
      "sourceLocation": "pdf:spans:[[93,1802,1834]]"
    },
    {
      "id": "unique-event-039:p0003",
      "kind": "body",
      "text": "at war in the city: the Witch\n",
      "sourceLocation": "pdf:spans:[[93,1834,1864]]"
    },
    {
      "id": "unique-event-039:p0004",
      "kind": "body",
      "text": "Children, who use black magic,\n",
      "sourceLocation": "pdf:spans:[[93,1864,1895]]"
    },
    {
      "id": "unique-event-039:p0005",
      "kind": "body",
      "text": "and the Halloween Gang who\n",
      "sourceLocation": "pdf:spans:[[93,1895,1922]]"
    },
    {
      "id": "unique-event-039:p0006",
      "kind": "body",
      "text": "used to bully the witch children\n",
      "sourceLocation": "pdf:spans:[[93,1922,1955]]"
    },
    {
      "id": "unique-event-039:p0007",
      "kind": "body",
      "text": "until they were scared off by\n",
      "sourceLocation": "pdf:spans:[[93,1955,1985]]"
    },
    {
      "id": "unique-event-039:p0008",
      "kind": "body",
      "text": "their magic. Then he leaves.",
      "sourceLocation": "pdf:spans:[[93,1985,2013]]"
    }
  ],
  "sourcePages": [
    93
  ]
}
