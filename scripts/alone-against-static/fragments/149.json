  "paragraphs": [
    {
      "id": "149:p0",
      "kind": "heading",
      "text": "$t1 == '149'?\r\n`",
      "sourceLocation": "txt:chars:35457:35473"
    },
    {
      "id": "149:p1",
      "kind": "body",
      "text": "\r\n",
      "sourceLocation": "txt:chars:35473:35475"
    },
    {
      "id": "149:p2",
      "kind": "body",
      "text": "你只跑出几步，就被男人追上。\r\n",
      "sourceLocation": "txt:chars:35475:35491"
    },
    {
      "id": "149:p3",
      "kind": "body",
      "text": "他的双臂抱住你的肩膀。你向前扑倒，脸摔在土地上。\r\n",
      "sourceLocation": "txt:chars:35491:35517"
    },
    {
      "id": "149:p4",
      "kind": "body",
      "text": "你挣扎拉扯着，但他像钢铁一样强硬。你感觉什么又湿又冷的东西抵住你的耳朵。\r\n",
      "sourceLocation": "txt:chars:35517:35555"
    },
    {
      "id": "149:p5",
      "kind": "body",
      "text": "记录你当前所在的条目，你可能需要回到当前条目。\r\n",
      "sourceLocation": "txt:chars:35555:35580"
    },
    {
      "id": "149:p6",
      "kind": "body",
      "text": "受到 1D4 点伤害。\r\n",
      "sourceLocation": "txt:chars:35580:35593"
    },
    {
      "id": "149:p7",
      "kind": "body",
      "text": "进行一次格斗（斗殴）检定。\r\n",
      "sourceLocation": "txt:chars:35593:35608"
    },
    {
      "id": "149:p8",
      "kind": "body",
      "text": "如果检定成功，转到 151。\r\n",
      "sourceLocation": "txt:chars:35608:35624"
    },
    {
      "id": "149:p9",
      "kind": "body",
      "text": "如果检定失败，转到 150。\r\n",
      "sourceLocation": "txt:chars:35624:35640"
    }
  ]
}
