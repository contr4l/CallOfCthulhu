    {
      "id": "196:p1",
      "kind": "body",
      "text": "An immense weight pounds you to the stone floor. Your neck snaps even as your skull shatters.",
      "sourceLocation": "9/977"
    },
    {
      "id": "196:p2",
      "kind": "body",
      "text": "You have been killed by a collapsing church roof! It was a bold but risky plan. Why not try the adventure again?",
      "sourceLocation": "9/978"
    },
    {
      "id": "196:p3",
      "kind": "body",
      "text": "The End.",
      "sourceLocation": "9/979"
    }
  ]
}
