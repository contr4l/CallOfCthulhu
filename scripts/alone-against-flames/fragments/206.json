    },
    {
      "id": "206:p1",
      "kind": "body",
      "text": "That swollen mouth gives a little twist upwards. “Yeah? Where’d you hear about it?”",
      "sourceLocation": "9/1020"
    },
    {
      "id": "206:p2",
      "kind": "body",
      "text": "You say something vague about an article in the newspaper.",
      "sourceLocation": "9/1021"
    },
    {
      "id": "206:p3",
      "kind": "body",
      "text": "“Newspapers must have changed since last time I read one.”",
      "sourceLocation": "9/1022"
    },
    {
      "id": "206:p4",
      "kind": "body",
      "text": "There is something in his tone you don’t like much.",
      "sourceLocation": "9/1023"
    },
    {
      "id": "206:p5",
      "kind": "body",
      "text": "Go to 221.",
      "sourceLocation": "9/1024"
    }
  ]
}
