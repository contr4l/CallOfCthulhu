{
  "id": "148",
  "document": "OEBPS/Print_Alone_Against_the_Flames.xhtml",
  "paragraphs": [
    {
      "id": "148:p0",
      "kind": "heading",
      "text": "148",
      "sourceLocation": "9/745"
    },
    {
      "id": "148:p1",
      "kind": "body",
      "text": "“Through your sacrifice the village will be reborn,” says the first dancer.",
      "sourceLocation": "9/746"
    },
    {
      "id": "148:p2",
      "kind": "body",
      "text": "“You pass from earth to air for all our sakes,” says the second.",
      "sourceLocation": "9/747"
    },
    {
      "id": "148:p3",
      "kind": "body",
      "text": "“Through incandescence may you find rapture,” says the third.",
      "sourceLocation": "9/748"
    },
    {
      "id": "148:p4",
      "kind": "body",
      "text": "Their dance weaves off and disappears behind the buildings.",
      "sourceLocation": "9/749"
    },
    {
      "id": "148:p5",
      "kind": "body",
      "text": "Go to 18.",
      "sourceLocation": "9/750"
    }
  ]
}
