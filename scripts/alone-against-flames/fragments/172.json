  "id": "172",
  "document": "OEBPS/Print_Alone_Against_the_Flames.xhtml",
  "paragraphs": [
    {
      "id": "172:p0",
      "kind": "heading",
      "text": "172",
      "sourceLocation": "9/855"
    },
    {
      "id": "172:p1",
      "kind": "body",
      "text": "You draw close to the man. He glares over his shoulder and sees you. “Damn you,” he spits, and slows down. “Can’t you leave a fellow be?”",
      "sourceLocation": "9/856"
    },
    {
      "id": "172:p2",
      "kind": "body",
      "text": "You assure him you mean him no harm.",
      "sourceLocation": "9/857"
    },
    {
      "id": "172:p3",
      "kind": "body",
      "text": "“We can’t talk here,” he says. “Follow me.”",
      "sourceLocation": "9/858"
    },
    {
      "id": "172:p4",
      "kind": "body",
      "text": "Go to 142.",
      "sourceLocation": "9/859"
    }
  ]
}
