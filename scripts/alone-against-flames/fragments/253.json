{
  "id": "253",
  "document": "OEBPS/Print_Alone_Against_the_Flames.xhtml",
  "paragraphs": [
    {
      "id": "253:p0",
      "kind": "heading",
      "text": "253",
      "sourceLocation": "9/1253"
    },
    {
      "id": "253:p1",
      "kind": "body",
      "text": "You get to your feet and back away towards the daylight. Arbogast gives a savage smile as he sees you go.",
      "sourceLocation": "9/1254"
    },
    {
      "id": "253:p2",
      "kind": "body",
      "text": "“Another who will not dare to listen. Frightened of truth. I will offer you one last piece of advice.”",
      "sourceLocation": "9/1255"
    },
    {
      "id": "253:p3",
      "kind": "body",
      "text": "Daylight burns across that scarred face, crouched in the subterranean shadow.",
      "sourceLocation": "9/1256"
    },
    {
      "id": "253:p4",
      "kind": "body",
      "text": "“Sleep not, stranger. Sleep not.”",
      "sourceLocation": "9/1257"
    },
    {
      "id": "253:p5",
      "kind": "body",
      "text": "Go to 160.",
      "sourceLocation": "9/1258"
    }
  ]
}
