  "paragraphs": [
    {
      "id": "250:p0",
      "kind": "heading",
      "text": "250",
      "sourceLocation": "9/1236"
    },
    {
      "id": "250:p1",
      "kind": "body",
      "text": "You approach the red-shrouded figures, expecting them at any moment to leap up and grab at you. There are three. Each has a label hanging from its toes:",
      "sourceLocation": "9/1237"
    },
    {
      "id": "250:p2",
      "kind": "body",
      "text": "Benjamin Cramer, 1/19/1927",
      "sourceLocation": "9/1238"
    },
    {
      "id": "250:p3",
      "kind": "body",
      "text": "Abraham Hollingsworth, 4/22/1927",
      "sourceLocation": "9/1239"
    },
    {
      "id": "250:p4",
      "kind": "body",
      "text": "Marian Phipps, 8/6/1927",
      "sourceLocation": "9/1240"
    },
    {
      "id": "250:p5",
      "kind": "body",
      "text": "You lift one corner of the shroud. Underneath, wrapped in tight bandages, is a thin but unmistakably human form. You are looking at three dead bodies. Embalmed dead bodies.",
      "sourceLocation": "9/1241"
    },
    {
      "id": "250:p6",
      "kind": "body",
      "text": "Make a Sanity roll. If you fail, lose 1D2 Sanity points.",
      "sourceLocation": "9/1242"
    },
    {
      "id": "250:p7",
      "kind": "body",
      "text": "Go to 256.",
      "sourceLocation": "9/1243"
    }
  ]
}
